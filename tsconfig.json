{
  "compilerOptions": {
    "module": "esnext",
    "declaration": true,
    "esModuleInterop": true,
    "target": "es2020",
    "lib": ["ES2020", "DOM"],
    "allowJs": false,
    "alwaysStrict": true,
    "allowUnreachableCode": false,
    "strict": true,
    "outDir": "dist/lib",
    "declarationDir": "dist/dts"
  },
  "exclude": ["node_modules"],
  "include": ["src/*.ts"]
}
